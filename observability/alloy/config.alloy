logging {
  level = "info"
}

// First-party apps push traces, metrics and logs over OTLP; this agent
// receives and routes them (see docs/adr/0001-app-logs-via-otlp-push.md)
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "logs" {
  grpc {
    endpoint = "0.0.0.0:31081"
  }
  http {
    endpoint = "0.0.0.0:31082"
  }
  output {
    logs = [otelcol.exporter.loki.apps.input]
  }
}

otelcol.exporter.loki "apps" {
  forward_to = [loki.write.default.receiver]
}
