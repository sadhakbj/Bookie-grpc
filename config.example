# Example Configuration File
# Copy this to .env for docker-compose

# gRPC Server Configuration
PORT=8020

# HTTP Client Configuration
HTTP_PORT=8080
GRPC_SERVER_ADDR=localhost:8020

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_LOGS_OTLP_ENDPOINT=localhost:31081
OTEL_METRICS_OTLP_ENDPOINT=localhost:9090

# Timezone
TZ=UTC

# MySQL Database Configuration (docker bootstrap + server + migrations)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bookie
DB_PASSWORD=bookie
DB_NAME=bookie

